# Copiar este archivo como .env y completar los valores propios.
# El .env no se sube al repositorio (figura en .gitignore).

# Puerto donde arranca el servidor
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_POOL_MAX=5

# Secreto privado para firmar JWT (al menos 32 bytes aleatorios). Nunca subir el real.
JWT_SECRET=

# URL base de la API (las rutas se arman a partir de acá, por ejemplo /carreras)
API_BASE_URL=http://localhost:3000/

# Conexión a la base de datos PostgreSQL (Supabase). Cada integrante pega la suya:
# usuario, contraseña, host, puerto y nombre de la base. Nunca se sube al repositorio
DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/postgres

# Certificado raíz descargado de Supabase (opcional si el sistema ya confía en él).
# Por defecto se busca prod-supabase.cer en la carpeta del backend.
# DATABASE_SSL_CA=prod-supabase.cer

# Solo para migrate dev: base de desarrollo AUXILIAR y vacía, distinta de DATABASE_URL.
# SHADOW_DATABASE_URL=postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/aida_shadow

# Claves de Nest Observe (monitoreo). Son personales de cada integrante: no se comparten.
# Si quedan vacías el servidor arranca igual: Observe solo avisa que no envía datos
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

# Adaptador opcional de selección de evidencia (HTTPS). Vacío usa recuperación local.
# Contrato documentado en docs/backend.md. No pegar claves reales en este ejemplo.
IA_ENDPOINT=
IA_API_KEY=

# WhatsApp Cloud API: sin estas variables el canal responde 503 y no envía mensajes.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=
