# Copiar este archivo como .env y completar los valores propios.
# El .env no se sube al repositorio (figura en .gitignore).

# Puerto donde arranca el servidor
PORT=3000

# Claves de Nest Observe (monitoreo). Son personales de cada integrante: no se comparten.
# Si quedan vacías el servidor arranca igual: Observe solo avisa que no envía datos
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
